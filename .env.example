# Copy this file to `.env` and fill in the values from your own Supabase project.
# Supabase Dashboard -> Project Settings -> API
#
# Both values are safe to expose in the browser bundle. The anon key is designed
# to be public; Row-Level Security is what protects your data.
#
# NOTE: these must be prefixed with VITE_ or Vite will not expose them to the app.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
